from os import PathLike
from types import TracebackType
from typing import Self

_Pem = str | PathLike[str] | bytes

class ZmuxError(Exception):
    kind: str
    retryable: bool
    code: int | None

class ConnectError(ZmuxError): ...
class SessionClosed(ZmuxError): ...
class EarlyDataRejected(SessionClosed): ...
class StreamError(ZmuxError): ...
class StreamReset(StreamError): ...
class StreamStopped(StreamError): ...
class IncompleteRead(StreamError): ...
class OpenError(ZmuxError): ...
class DatagramError(ZmuxError): ...
class PipeError(ZmuxError): ...

class Config:
    def __init__(
        self,
        *,
        handshake_timeout: float | None = None,
        idle_timeout: float | None = None,
        keep_alive: float | None = None,
        datagrams: bool | None = None,
        max_incoming_streams: int | None = None,
        max_pipes: int | None = None,
        psk: bytes | None = None,
        tls_auth: bool = False,
        resume_timeout: float | None = None,
        early_data: bool = False,
        carrier_early_data: bool = False,
        protocols: list[str] | None = None,
        dead_timeout: float | None = None,
        suspect_floor: float | None = None,
        probation: float | None = None,
    ) -> None: ...

class TlsConfig:
    def __init__(
        self,
        *,
        cert: _Pem | None = None,
        key: _Pem | None = None,
        ca: _Pem | None = None,
        verify: bool = True,
        alpn: list[str] | None = None,
    ) -> None: ...

class PipeIo: ...

class PipeEnd:
    async def read(self, n: int = 65536) -> bytes: ...
    async def write(self, data: bytes) -> None: ...

def pipe_pair() -> tuple[PipeIo, PipeEnd]: ...
async def dial_tcp(addr: str) -> PipeIo: ...
async def dial_tls(addr: str, server_name: str, tls: TlsConfig) -> PipeIo: ...
async def dial_quic(addr: str, server_name: str, tls: TlsConfig, lanes: int = 4) -> PipeIo: ...
async def dial_websocket(
    url: str, tls: TlsConfig | None = None, headers: list[tuple[str, str]] | None = None
) -> PipeIo: ...
async def dial_http(addr: str, path: str = "/zmux") -> PipeIo: ...
async def dial_h3(url: str, tls: TlsConfig, addr: str | None = None, lanes: int = 4) -> PipeIo: ...
async def dial_webtransport(url: str, tls: TlsConfig, lanes: int = 4) -> PipeIo: ...

class Http2Connection:
    @staticmethod
    async def connect(
        addr: str, path: str = "/zmux", tls: TlsConfig | None = None, server_name: str | None = None
    ) -> Http2Connection: ...
    async def open_pipe(self) -> PipeIo: ...

class ZeroRtt:
    @property
    def sent(self) -> bool: ...
    @property
    def accepted(self) -> bool | None: ...
    @property
    def rewritten(self) -> bool: ...

class QuicClient:
    def __init__(
        self,
        tls: TlsConfig,
        *,
        lanes: int = 4,
        zero_rtt: bool = False,
        memory_capacity: int | None = None,
        bind: str = "0.0.0.0:0",
    ) -> None: ...
    async def dial(self, addr: str, server_name: str) -> PipeIo: ...
    async def connect(
        self, addr: str, server_name: str, config: Config | None = None
    ) -> tuple[Session, ZeroRtt]: ...
    def forget(self, server_name: str) -> None: ...
    def clear(self) -> None: ...
    def remembers(self, server_name: str) -> bool: ...

_Tlvs = list[tuple[int, bytes]]

class SendStream:
    @property
    def id(self) -> int | None: ...
    async def write(self, data: bytes) -> None: ...
    async def finish(self) -> None: ...
    async def reset(self, code: int = 0) -> None: ...
    def set_priority(self, urgency: int, incremental: bool) -> None: ...
    async def stopped(self) -> int | None: ...

class RecvStream:
    @property
    def id(self) -> int | None: ...
    @property
    def is_replayable(self) -> bool: ...
    async def read(self, n: int = 65536) -> bytes: ...
    async def read_exact(self, n: int) -> bytes: ...
    async def read_to_end(self, limit: int = 16777216) -> bytes: ...
    async def stop(self, code: int = 0) -> None: ...
    def preamble(self) -> tuple[bytes | None, _Tlvs]: ...

class Pipe:
    @property
    def id(self) -> int: ...
    async def joined(self) -> None: ...
    def set_priority(self, priority: int) -> None: ...
    def set_standby(self, standby: bool) -> None: ...
    def set_weight(self, weight: int) -> None: ...
    def close(self) -> None: ...
    def abort(self) -> None: ...
    def stats(self) -> dict[str, object] | None: ...

class PipeReservation:
    @property
    def id(self) -> int: ...
    @property
    def frame(self) -> bytes: ...
    @property
    def header(self) -> str: ...
    def attach(self, pipe: PipeIo) -> Pipe: ...
    def cancel(self) -> None: ...

class Session:
    @staticmethod
    async def connect(pipe: PipeIo, config: Config | None = None) -> Session: ...
    @staticmethod
    async def accept(pipe: PipeIo, config: Config | None = None) -> Session: ...
    @staticmethod
    async def peer(pipe: PipeIo, config: Config | None = None) -> Session: ...
    async def open_bi(
        self,
        *,
        info: bytes | None = None,
        tlvs: _Tlvs | None = None,
        priority: tuple[int, bool] | None = None,
        peer_priority: tuple[int, bool] | None = None,
    ) -> tuple[SendStream, RecvStream]: ...
    async def open_uni(
        self, *, info: bytes | None = None, tlvs: _Tlvs | None = None, priority: tuple[int, bool] | None = None
    ) -> SendStream: ...
    async def accept_bi(self) -> tuple[SendStream, RecvStream]: ...
    async def accept_uni(self) -> RecvStream: ...
    def send_datagram(self, data: bytes) -> None: ...
    async def read_datagram(self) -> bytes: ...
    @property
    def max_datagram_size(self) -> int | None: ...
    def close(self, code: int = 0, reason: bytes = b"") -> None: ...
    async def shutdown(self, code: int = 0, reason: bytes = b"") -> None: ...
    async def wait_closed(self) -> SessionClosed: ...
    async def ping(self) -> float: ...
    async def next_event(self) -> tuple[str, str] | None: ...
    def add_pipe(
        self, pipe: PipeIo, *, priority: int | None = None, standby: bool | None = None, weight: int | None = None
    ) -> Pipe: ...
    def reserve_pipe(
        self,
        direction: str = "bidi",
        *,
        priority: int | None = None,
        standby: bool | None = None,
        weight: int | None = None,
    ) -> PipeReservation: ...
    @property
    def join_ready(self) -> bool: ...
    def revalidate_pipes(self) -> None: ...
    def pipes(self) -> list[Pipe]: ...
    def pipe_stats(self) -> list[dict[str, object]]: ...
    @property
    def role(self) -> str: ...
    @property
    def rtt(self) -> float | None: ...
    @property
    def protocol(self) -> str | None: ...
    @property
    def is_plain_qmux_peer(self) -> bool: ...
    @property
    def state(self) -> str: ...
    async def __aenter__(self) -> Self: ...
    async def __aexit__(
        self, t: type[BaseException] | None, v: BaseException | None, tb: TracebackType | None
    ) -> bool: ...
    def __aiter__(self) -> Self: ...
    async def __anext__(self) -> tuple[SendStream, RecvStream]: ...

class Listener:
    def __init__(self, config: Config | None = None) -> None: ...
    async def serve_tcp(self, addr: str) -> str: ...
    async def serve_tls(self, addr: str, tls: TlsConfig) -> str: ...
    async def serve_quic(self, addr: str, tls: TlsConfig, lanes: int = 4, zero_rtt: bool = False) -> str: ...
    async def serve_h3(self, addr: str, tls: TlsConfig, lanes: int = 4) -> str: ...
    async def serve_webtransport(self, addr: str, tls: TlsConfig, lanes: int = 4) -> str: ...
    async def serve_websocket(self, addr: str, tls: TlsConfig | None = None) -> str: ...
    async def serve_http(self, addr: str, path: str = "/zmux", tls: TlsConfig | None = None) -> str: ...
    async def handle_pipe(self, pipe: PipeIo) -> None: ...
    async def accept(self) -> Session | None: ...
    def close(self) -> None: ...
    async def __aenter__(self) -> Self: ...
    async def __aexit__(
        self, t: type[BaseException] | None, v: BaseException | None, tb: TracebackType | None
    ) -> bool: ...
    def __aiter__(self) -> Self: ...
    async def __anext__(self) -> Session: ...
